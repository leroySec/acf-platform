BASE_CYCLE_SECONDS = 10
MIN_CYCLE_SECONDS = 3
MAX_CYCLE_SECONDS = 30
READER_FRESH_SECONDS = 30
MAX_READ_BYTES = 32 * 1024
EVENTLOG_MAX_PER_CYCLE = 200
MAX_ITEMS_PER_CYCLE = 200

MAX_KNOWN_FILES_BUDGET = 150
DISCOVERY_BUDGET = 50

DEFAULT_FAILURE_PATTERNS = [
    r"(?i)fail", r"(?i)error", r"(?i)denied", r"(?i)invalid",
    r"(?i)rejected", r"(?i)attack", r"(?i)malware", r"(?i)virus",
    r"(?i)unauthorized", r"(?i)authentication failure",
]
_COMPILED_DEFAULT = [re.compile(p) for p in DEFAULT_FAILURE_PATTERNS]

